# Runtime close to the CLIC devkit image for the GC decoder: CUDA 12.4 runtime, Python 3, torch 2.6.0, numpy 1.26.4.
# No compiler inside on purpose (the server image has none): the decoder must use its prebuilt _rans.so.
#   docker build --platform linux/amd64 -f clic/l4/Dockerfile.gc -t clic-gc:cu124 clic/l4
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install torch==2.6.0 --index-url https://download.pytorch.org/whl/cu124 \
 && python3 -m pip install numpy==1.26.4 pillow
WORKDIR /work
