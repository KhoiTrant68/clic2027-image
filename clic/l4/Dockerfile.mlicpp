FROM python:3.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 \
    TORCH_CUDNN_V8_API_DISABLED=1 CUBLAS_WORKSPACE_CONFIG=:4096:8 \
    OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 \
    LD_LIBRARY_PATH=/usr/local/lib/python3.10/site-packages/nvidia/cuda_nvrtc/lib

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

COPY mlicpp-runtime.lock /tmp/mlicpp-runtime.lock
RUN python -m pip install --no-cache-dir -c /tmp/mlicpp-runtime.lock numpy setuptools wheel \
    && python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu118 \
       torch==2.0.1+cu118 torchvision==0.15.2+cu118 \
    && python -m pip install --no-cache-dir --no-build-isolation -r /tmp/mlicpp-runtime.lock \
    && ln -sf libnvrtc.so.11.2 "$LD_LIBRARY_PATH/libnvrtc.so" \
    && python -m pip check \
    && python -c 'import ctypes, compressai, torch; ctypes.CDLL("libnvrtc.so"); assert torch.version.cuda == "11.8"; assert compressai.__version__ == "1.2.0b3"'
