<mxfile host="drawio"><diagram name="Pipeline mã hóa – giải mã" id="2_pipeline_ma_hoa_giai_ma"><mxGraphModel dx="760" dy="384" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="384" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Chỉ phần quyết định CDF phải khớp từng bit; DiT và DC-AE chạy float" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=15;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1F1F1F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="712" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Mode lai. Ô tô màu: tính bằng số nguyên, encoder và server phải ra cùng một kết quả" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="24" y="40" width="712" height="18" as="geometry"/></mxCell><mxCell id="c5" value="ENCODER (máy của em)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="72" width="300" height="18" as="geometry"/></mxCell><mxCell id="c6" value="DECODER (server L4)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="224" width="300" height="18" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Ảnh x&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;RGB, H × W&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="24" y="92" width="124" height="72" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;DC-AE enc&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;latent 32 kênh&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;nén 32× / chiều&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="171" y="92" width="124" height="72" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;g_a, × gain[r]&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;rate r: 8 mức&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;bước Δ = 1/gain&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="318" y="92" width="124" height="72" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Dither + round&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;q = round(y + u)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;u chung, từ seed&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#DAE8FC;strokeColor=#1F6FEB;strokeWidth=2;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="465" y="92" width="124" height="72" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;rANS encode&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;CDF từ h_s&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: