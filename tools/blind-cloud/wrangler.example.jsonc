{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clic-blind-study",
  "main": "worker.mjs",
  "compatibility_date": "2025-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./deployment/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "clic-blind-study",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }]
}
