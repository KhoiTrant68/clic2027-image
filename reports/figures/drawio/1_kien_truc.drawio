<mxfile host="drawio"><diagram name="Kiến trúc đề xuất" id="1_kien_truc"><mxGraphModel dx="760" dy="664" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="664" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="" style="rounded=1;arcSize=8;absoluteArcSize=1;html=1;fillColor=none;dashed=1;dashPattern=4 4;strokeColor=#CFCFCF;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="24" y="204" width="712" height="436" as="geometry"/></mxCell><mxCell id="c4" value="Decoder cố định trên server; encoder chọn mode và chia bit cho từng ảnh" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=15;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1F1F1F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="18" width="712" height="24" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Encoder (chạy ngoài server, không bị đóng băng)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;Chọn mode, chia bit giữa các ảnh và giữa base/residual, tìm seed, tối ưu latent theo Q̂&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="24" y="48" width="712" height="56" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Bitstream bs.zip, tổng byte ≤ ngân sách cả tập&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;Header mỗi ảnh: H, W, mode, rate_idx, seed_idx, cờ; sau đó là các stream z, y và stream phụ&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="24" y="128" width="712" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Decoder trên server, đóng băng trước 01/03" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#1F1F1F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="400" height="20" as="geometry"/></mxCell><mxCell id="c8" value="Mode lai: ảnh tự nhiên và hỗn hợp" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="300" height="18" as="geometry"/></mxCell><mxCell id="c9" value="Mode SCC: ảnh màn hình" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=11.5;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="488" y="242" width="200" height="18" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Entropy decode số nguyên (CPU)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;Hyperprior int8 + rANS, khớp từng bit trên mọi thiết bị&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="264" width="424" height="56" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Bridge một bước (SANA-0.6B)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;ŷ có dither → latent sắc nét; seed nhiễu đọc từ header&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="424" height="56" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;DC-AE decoder&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;Latent f32c32 → ảnh base x̂ (hiện mất 4.6 s/ảnh trên T4)&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="424" height="56" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Residual có điều kiện theo x̂&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px"&gt;Giải mã phần dư x − x̂; gánh độ trung thực ở 0.15–0.3 bpp&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#DAE8FC;strokeColor=#1F6FEB;strokeWidth=2;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="504" width="424" height="56" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;VVC-SCC decoder&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;VTM 23.8, có sẵn trong devkit&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11.5px" color="#666666"&gt;IBC, palette, 4:4:4&lt;/font&gt;' style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily=Helvetica;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="488" y="264" width="232" height="72" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Ảnh PNG đầu ra cho từng ảnh&lt;/b&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingTop=2;fontSize=13;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.25;fontFamily